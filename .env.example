# Copy to .env and fill in. .env is never committed.

# Vivosun cloud account (same login as the Vivosun app)
VIVOSUN_EMAIL=you@example.com
VIVOSUN_PASSWORD=change-me

# Camera on the LAN
CAMERA_NAME_MATCH=GrowCam
CAMERA_IP=192.168.1.88
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0

# go2rtc target(s), comma-separated
GO2RTC_API_URL=http://go2rtc:1984,http://frigate:1984
STREAM_NAME=growcam
# Optional basic auth for the go2rtc API
STREAM_VIEW_USER=
STREAM_VIEW_PASS=

# Full refresh every 6 h, existence check every 60 s
REFRESH_INTERVAL_SECONDS=21600
CHECK_INTERVAL_SECONDS=60
